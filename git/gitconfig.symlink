[user]
  name = Bryan Mikaelian
  email = bryan.mikaelian@agilebits.com
  # signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGj8KNEBGFIVL4D/dh/MpPLEwdPqEM2D6PNktXlshgeo
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIB1JxY3CNLZF+YKgrp3D0QVV2coE9e98FpgekNPNKnbx

[color]
  ui = true

[color "status"]
  added = yellow
  changed = green
  branch = cyan bold

[github]
  user = bryanmikaelian

[branch]
  autosetuprebase = always

[alias]
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset' --abbrev-commit --date=relative
  s = status --short
  shove = push --force-with-lease
[core]
  excludesfile = ~/.gitignore
[grep]
  lineNumber = true
[commit]
  gpgsign = true
[gpg]
  format = ssh
[gpg "ssh"]
  # linux
  # program = "/opt/1Password/op-ssh-sign"

  # macOS
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
[url "git@github.com:"]
  insteadOf = https://github.com/

[url "ssh://git@gitlab.1password.io:2227"]
  insteadOf = https://gitlab.1password.io
