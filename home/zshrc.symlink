export PATH="./bin:$HOME/.dotfiles/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/usr/X11/bin:$HOME/.rvm/bin:$GOPATH/bin:/bin:$HOME/.cargo/bin:/usr/local/go/bin:$HOME/bin"
export SHELL="$(which zsh)"
export ZSH=$HOME/.oh-my-zsh
export DISABLE_LS_COLORS="false"
export DOTFILES=$HOME/.dotfiles
export EDITOR='nvim'
export PROJECTS=~/Code/github.com
export STARSHIP_CONFIG="${HOME}/.config/starship.toml"

# Ensure SSH is managed by 1password
case "$OSTYPE" in
  darwin*)
    export SSH_AUTH_SOCK=~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock
    ;;
  linux*)
    export SSH_AUTH_SOCK=~/.1password/agent.sock
    ;;
  *)
    echo "1password SSH Agent not supported"
    ;;
esac

# source every .zsh file in this repo
for config_file ($DOTFILES/**/*.zsh) source $config_file

# load zsh env vars
source "${HOME}/.zshenv"

# load oh-my-zsh
source $HOME/.oh-my-zsh/oh-my-zsh.sh

# Starship Prompt
eval "$(starship init zsh)"

# reload functions
# freload() { while (( $# )); do; unfunction $1; autoload -U $1; shift; done }

# initialize autocomplete here, otherwise functions won't be loaded
autoload -U compinit
compinit

# url-quote-magic
autoload url-quote-magic
zle -N self-insert url-quote-magic
