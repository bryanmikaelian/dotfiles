# Show git status across all repos in current workspace
local repos=$(find . -maxdepth 2 -name .git -type d ! -path ./.git | sed 's|/\.git||' | sort)

for repo in ${(f)repos}; do
  local changes=$(git -C "$repo" status --short 2>/dev/null)
  if [ -n "$changes" ]; then
    echo "\033[1;33m$repo\033[0m"
    echo "$changes"
    echo ""
  fi
done
