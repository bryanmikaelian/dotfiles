# Agentic coding layout: claude | lazygit | blank terminal
# Usage: ac <path>
local project_path="${1:?Usage: ac <path>}"
project_path="${project_path:A}"

if [ ! -d "$project_path" ]; then
  echo "Error: $project_path is not a directory"
  return 1
fi

# Opens three Ghostty tabs in the front window via AppleScript
osascript - "$project_path" <<'EOF'
on run argv
  set p to item 1 of argv
  tell application "Ghostty"
    set w to front window
    -- Tab 1: Claude
    new tab in w with configuration {initial working directory:p, initial input:"claude" & linefeed}
    -- Tab 2: lazygit
    new tab in w with configuration {initial working directory:p, initial input:"lazygit" & linefeed}
    -- Tab 3: blank terminal
    new tab in w with configuration {initial working directory:p}
  end tell
end run
EOF
